require "log"
require "yaml"
require "file_utils"
require "../shell"

module CrystKit
  module Builder
    module Commands
      # Implements `crystkit plugin new` — scaffolds a new CrystKit plugin.
      #
      # The generated plugin is ready to `shards install` and wire into an
      # app via `app.use`.
      class PluginScaffold
        # :nodoc:
        Log = ::Log.for(self)

        # The requested plugin name (sanitized to a valid identifier).
        getter name : String
        # Base directory under which the plugin directory is created.
        getter path : String

        # Creates a plugin scaffold command.
        def initialize(@name : String, @path = ".")
        end

        # Generates the plugin directory and stub files.
        #
        # Raises if the target directory already exists.
        def run : Nil
          output_dir = Path[path]
          Dir.mkdir_p(output_dir.to_s)

          plugin_name = name.gsub(/[^a-zA-Z0-9_]/, "_")
          plugin_class = camelize(plugin_name)
          dir_name = "#{plugin_name}_plugin"
          plugin_dir = output_dir / dir_name

          if Dir.exists?(plugin_dir.to_s)
            raise "Directory '#{plugin_dir}' already exists"
          end

          Dir.mkdir_p(plugin_dir.to_s)
          create_shard(plugin_dir, plugin_name, plugin_class)
          create_backend(plugin_dir, plugin_class, plugin_name)
          create_frontend(plugin_dir, plugin_name)
          create_readme(plugin_dir, plugin_name, plugin_class)

          Log.info { "Created CrystKit plugin '#{plugin_name}' at #{plugin_dir}" }
          Log.info { "Next steps:" }
          Log.info { "  1. cd #{plugin_dir} && shards install" }
          Log.info { "  2. In your app: require \"#{dir_name}/#{plugin_name}_plugin\"" }
          Log.info { "     app.use #{plugin_class}.new" }
          Log.info { "  3. In your frontend:" }
          Log.info { "     import { #{plugin_class} } from './plugins/#{dir_name}/frontend'" }
        end

        # :nodoc:
        private def create_shard(dir : Path, name : String, class_name : String)
          shard = <<-YAML
name: #{name}
version: 0.1.0

dependencies:
  crystkit:
    github: naqvis/crystkit

crystal: ~> 1.0

license: MIT
YAML
          File.write((dir / "shard.yml").to_s, shard)
        end

        # :nodoc:
        private def create_backend(dir : Path, class_name : String, identifier : String)
          source = <<-CRYSTAL
require "crystkit"

module CustomPlugins
  class #{class_name} < CrystKit::Plugin::Base
    def identifier : String
      "#{identifier}"
    end

    def initialize_plugin(context : CrystKit::Plugin::Context) : Nil
      context.command "#{identifier}.hello", String do |name|
        "Hello, \#{name}!"
      end

      context.listen "app:ready" do |payload|
        Log.info { "App is ready: \#{payload}" }
      end
    end

    def cleanup_plugin : Nil
    end
  end
end
CRYSTAL
          File.write((dir / "#{identifier}_plugin.cr").to_s, source)
        end

        # :nodoc:
        private def create_frontend(dir : Path, identifier : String)
          source = <<-JS
export default function #{identifier}Plugin(ipc) {
  return {
    hello: (name) => ipc.invoke('#{identifier}.hello', name),
  };
}
JS
          File.write((dir / "frontend.js").to_s, source)
        end

        # :nodoc:
        private def create_readme(dir : Path, identifier : String, class_name : String)
          readme = <<-MD
# #{class_name} — CrystKit Plugin

Generated by `crystkit plugin new --name #{identifier}`
MD
          File.write((dir / "README.md").to_s, readme)
        end

        # :nodoc:
        private def camelize(str : String) : String
          str.split(/[_\-\s]+/).reject(&.empty?).map(&.camelcase).join
        end
      end

      # Implements `crystkit plugin build` — compiles a plugin via
      # `shards build` and copies the resulting binary to an output directory.
      class PluginBuild
        # :nodoc:
        Log = ::Log.for(self)

        # Path to the plugin directory to build.
        getter path : String
        # Directory where the compiled binary is placed.
        getter output_dir : String

        # Creates a plugin build command.
        def initialize(@path : String, @output_dir = "./build")
        end

        # Builds the plugin.
        #
        # Raises if no `shard.yml` is found in *path* or if `shards build`
        # fails.
        def run : Nil
          plugin_dir = Path[path]
          shard_path = plugin_dir / "shard.yml"
          unless File.exists?(shard_path.to_s)
            raise "No shard.yml found in #{plugin_dir}. Is this a CrystKit plugin?"
          end

          Dir.mkdir_p(output_dir)
          # Resolve output_dir to an absolute path *before* `Dir.cd` below —
          # otherwise `Path[output_dir]` inside the block is reinterpreted
          # relative to `plugin_dir`, landing the binary in the wrong place.
          dest_dir = Path[output_dir].expand

          Dir.cd(plugin_dir.to_s) do
            Log.info { "Building plugin at #{plugin_dir}..." }

            unless Shell.exec("shards", ["build"], chdir: plugin_dir.to_s)
              raise "Failed to build plugin"
            end

            output_name = plugin_dir.basename
            ext = {% if flag?(:win32) %} ".exe" {% else %} "" {% end %}
            binary_src = plugin_dir / "bin" / "#{output_name}#{ext}"

            if File.exists?(binary_src.to_s)
              dest = dest_dir / "#{output_name}#{ext}"
              File.copy(binary_src.to_s, dest.to_s)
              File.chmod(dest.to_s, 0o755)
              Log.info { "Plugin binary: #{dest}" }
            end
          end

          Log.info { "Plugin build complete: #{output_dir}" }
        end
      end

      # Implements `crystkit plugin add` — wires an external plugin into a
      # CrystKit project.
      #
      # Adds a `path:` dependency to the project's `shard.yml`, inserts a
      # `require` and `app.use` line into `src/main.cr`, and copies the
      # plugin's non-`shard.yml` assets into `plugins/<name>_plugin`. The
      # plugin class name is derived by camelizing the plugin name.
      class PluginAdd
        # :nodoc:
        Log = ::Log.for(self)

        # Path to the plugin directory to add.
        getter plugin_path : String
        # Path to the project to wire the plugin into.
        getter project_path : String

        # Creates a plugin add command.
        def initialize(@plugin_path : String, @project_path = ".")
        end

        # Wires the plugin into the project.
        #
        # Raises if either the project or plugin lacks a `shard.yml`, or
        # if the plugin name cannot be determined.
        def run : Nil
          project = Path[project_path]
          shard_path = project / "shard.yml"
          unless File.exists?(shard_path.to_s)
            raise "No shard.yml found in #{project}. Is this a CrystKit project?"
          end

          src_path = Path[plugin_path]
          shard_yml_path = src_path / "shard.yml"
          unless File.exists?(shard_yml_path.to_s)
            raise "No shard.yml found in #{src_path}. Is this a CrystKit plugin?"
          end

          plugin_name = extract_plugin_name(shard_yml_path.to_s)
          unless plugin_name
            raise "Could not determine plugin name from #{shard_yml_path}"
          end

          plugin_class = camelize(plugin_name.gsub(/[^a-zA-Z0-9_]/, "_"))

          add_shard_dependency(project, shard_path.to_s, plugin_name, src_path.to_s)
          add_plugin_require(project, plugin_name, plugin_class)
          copy_plugin_assets(project, plugin_name, src_path.to_s)

          Log.info { "Plugin '#{plugin_name}' added to project." }
          Log.info { "Next step: app.use #{plugin_class}.new in src/main.cr" }
        end

        # :nodoc:
        private def extract_plugin_name(shard_yml : String) : String?
          yaml = YAML.parse(File.read(shard_yml))
          yaml["name"]?.try(&.as_s?)
        end

        # :nodoc:
        private def add_shard_dependency(project : Path, shard_path : String, name : String, src : String)
          raise "Plugin path cannot contain newlines" if src.includes?('\n')
          content = File.read(shard_path)
          yaml = YAML.parse(content)

          # Check if dependency already exists
          if deps = yaml["dependencies"]?
            return if deps.as_h?.try(&.has_key?(name))
          end

          # Build a String-keyed output hash for serialization
          output = {} of String => YAML::Any
          yaml.as_h.each do |k, v|
            output[k.as_s] = v
          end

          # Build dependencies as Hash(YAML::Any, YAML::Any) so it can
          # be wrapped in YAML::Any.
          new_deps = {} of YAML::Any => YAML::Any
          if existing = output["dependencies"]?
            if existing_h = existing.as_h?
              existing_h.each do |k, v|
                new_deps[k] = v
              end
            end
          end

          dep_entry = {} of YAML::Any => YAML::Any
          dep_entry[YAML::Any.new("path")] = YAML::Any.new(src)
          new_deps[YAML::Any.new(name)] = YAML::Any.new(dep_entry)

          output["dependencies"] = YAML::Any.new(new_deps)

          File.write(shard_path, output.to_yaml)
          Log.info { "Added #{name} to #{shard_path}" }
        end

        # :nodoc:
        private def add_plugin_require(project : Path, name : String, class_name : String)
          main_path = project / "src" / "main.cr"
          return unless File.exists?(main_path.to_s)

          content = File.read(main_path.to_s)
          require_line = "require \"#{name}_plugin/#{name}_plugin\"\n"
          return if content.includes?(require_line.strip)

          content = require_line + content
          use_line = "app.use #{class_name}.new\n"
          content = content.sub("app.run", "#{use_line}app.run")
          File.write(main_path.to_s, content)
          Log.info { "Wired #{class_name} into #{main_path}" }
        end

        # :nodoc:
        private def copy_plugin_assets(project : Path, name : String, src : String)
          src_dir = Path[src]
          dest_dir = project / "plugins" / "#{name}_plugin"
          return unless Dir.exists?(src_dir.to_s)

          Dir.mkdir_p(dest_dir.to_s)
          Dir.each_child(src_dir.to_s) do |entry|
            next if entry == "shard.yml"
            s = File.join(src_dir.to_s, entry)
            d = File.join(dest_dir.to_s, entry)
            if File.file?(s)
              File.copy(s, d)
            elsif File.directory?(s)
              FileUtils.cp_r(s, d)
            end
          end
          Log.info { "Copied plugin assets to #{dest_dir}" }
        end

        # :nodoc:
        private def camelize(str : String) : String
          str.split(/[_\-\s]+/).reject(&.empty?).map(&.camelcase).join
        end
      end

      # Implements `crystkit plugin remove` — unwires a plugin from a
      # CrystKit project.
      #
      # The inverse of `PluginAdd`: removes the `path:` dependency from
      # `shard.yml`, strips the `require` and `app.use` lines from
      # `src/main.cr`, and deletes the `plugins/<name>_plugin` assets
      # directory.
      class PluginRemove
        # :nodoc:
        Log = ::Log.for(self)

        # Name of the plugin to remove.
        getter plugin_name : String
        # Path to the project to remove the plugin from.
        getter project_path : String

        # Creates a plugin remove command.
        def initialize(@plugin_name : String, @project_path = ".")
        end

        # Unwires the plugin from the project, raising if the project lacks a
        # `shard.yml`.
        def run : Nil
          project = Path[project_path]
          shard_path = project / "shard.yml"
          unless File.exists?(shard_path.to_s)
            raise "No shard.yml found in #{project}"
          end

          name = plugin_name.gsub(/[^a-zA-Z0-9_]/, "_")
          plugin_class = camelize(name)

          remove_shard_dependency(shard_path.to_s, name)
          remove_plugin_require(project, name, plugin_class)
          remove_plugin_assets(project, name)

          Log.info { "Plugin '#{name}' removed from project." }
        end

        # :nodoc:
        private def remove_shard_dependency(shard_path : String, name : String)
          content = File.read(shard_path)
          dep_regex = /  #{Regex.escape(name)}:\n    path: .+\n/
          new_content = content.gsub(dep_regex, "")
          File.write(shard_path, new_content)
          Log.info { "Removed #{name} from #{shard_path}" }
        end

        # :nodoc:
        private def remove_plugin_require(project : Path, name : String, class_name : String)
          main_path = project / "src" / "main.cr"
          return unless File.exists?(main_path.to_s)

          content = File.read(main_path.to_s)
          new_content = content
            .gsub("require \"#{name}_plugin/#{name}_plugin\"\n", "")
            .gsub("app.use #{class_name}.new\n", "")
          File.write(main_path.to_s, new_content)
          Log.info { "Unwired #{class_name} from #{main_path}" }
        end

        # :nodoc:
        private def remove_plugin_assets(project : Path, name : String)
          dir = project / "plugins" / "#{name}_plugin"
          if Dir.exists?(dir.to_s)
            FileUtils.rm_rf(dir.to_s)
            Log.info { "Removed plugin assets from #{dir}" }
          end
        end

        # :nodoc:
        private def camelize(str : String) : String
          str.split(/[_\-\s]+/).reject(&.empty?).map(&.camelcase).join
        end
      end
    end
  end
end
